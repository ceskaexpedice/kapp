<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>InitServlet</servlet-name>
        <servlet-class>cz.nkp.kuapp.kuappweb.InitServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>ApiServlet</servlet-name>
        <servlet-class>cz.nkp.kuapp.kuappweb.ApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiServlet</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LicenseChangesServlet</servlet-name>
        <servlet-class>cz.nkp.kuapp.kuappweb.LicenseChangesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LicenseChangesServlet</servlet-name>
        <url-pattern>/changes</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>RestApiServlet</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>javax.ws.rs.Application</param-name>
            <param-value>cz.nkp.kuapp.kuappweb.rest.RestApplication</param-value>
        </init-param>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>RestApiServlet</servlet-name>
        <url-pattern>/rest/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>IndexServlet</servlet-name>
        <servlet-class>cz.nkp.kuapp.kuappweb.IndexServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IndexServlet</servlet-name>
        <url-pattern>/index/*</url-pattern>
        <multipart-config>
            <location>/tmp</location>
            <max-file-size>2000848820</max-file-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet-mapping>
    <servlet>
        <servlet-name>StaticServlet</servlet-name>
        <jsp-file>/index.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaticServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/library-rights</url-pattern>
        <url-pattern>/home</url-pattern>
        <url-pattern>/keycloak</url-pattern>
        <url-pattern>/batches</url-pattern>
        <url-pattern>/titles</url-pattern>
        <url-pattern>/authors</url-pattern>
        <url-pattern>/results</url-pattern>
        <url-pattern>/contracts</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            300
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
